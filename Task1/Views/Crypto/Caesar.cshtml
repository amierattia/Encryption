@model Task1.Models.CaesarViewModel

<form asp-controller="Crypto" asp-action="Caesar" method="post" class="crypto-form mt-3">
    <h5 class="section-title mb-3">Caesar Cipher</h5>

    <div class="btn-group mb-3" role="group">
        <input type="radio" class="btn-check" asp-for="Mode" value="Encrypt" id="encrypt" checked>
        <label class="btn btn-outline-crypto" for="encrypt">Encrypt</label>

        <input type="radio" class="btn-check" asp-for="Mode" value="Decrypt" id="decrypt">
        <label class="btn btn-outline-crypto" for="decrypt">Decrypt</label>
    </div>

    <div class="mb-3">
        <label asp-for="Text" class="form-label fw-bold"></label>
        <textarea asp-for="Text" class="form-control" rows="3" oninput="validateText(this)" placeholder="Enter English text only..."></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RawKey" class="form-label fw-bold"></label>
        <input asp-for="RawKey" type="number" class="form-control" />
        <div class="form-text text-muted">We'll calculate the real key using <code>key % 26</code>.</div>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary">Process</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model?.Result))
    {
        <div class="alert crypto-alert mt-4 shadow">
            <strong>Result:</strong>
            <p>@Model.Result</p>
        </div>
    }
</form>
