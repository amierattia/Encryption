@model dynamic
@{
    ViewData["Title"] = "Crypto Tools";
}

<div class="card shadow-lg p-4">
    <ul class="nav nav-tabs mb-4" id="cryptoTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="caesar-tab" data-bs-toggle="tab" data-bs-target="#caesar" type="button" role="tab">Caesar Cipher</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="rail-tab" data-bs-toggle="tab" data-bs-target="#rail" type="button" role="tab">Rail Fence Cipher</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="vigenere-tab" data-bs-toggle="tab" data-bs-target="#vigenere" type="button" role="tab">Vigenère Cipher</button>
        </li>
    </ul>

    <div class="tab-content" id="cryptoTabsContent">
        <div class="tab-pane fade show active" id="caesar" role="tabpanel">
            @await Html.PartialAsync("~/Views/Crypto/Caesar.cshtml", new Task1.Models.CaesarViewModel())
        </div>
        <div class="tab-pane fade" id="rail" role="tabpanel">
            @await Html.PartialAsync("~/Views/Crypto/RailFence.cshtml", new Task1.Models.RailFenceViewModel())
        </div>
        <div class="tab-pane fade" id="vigenere" role="tabpanel">
            @await Html.PartialAsync("~/Views/Crypto/Vigenere.cshtml", new Task1.Models.VigenereViewModel())
        </div>
    </div>
</div>
